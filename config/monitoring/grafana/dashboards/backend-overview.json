{
  "title": "Backend Overview",
  "uid": "backend-overview",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": {"h": 3, "w": 24, "x": 0, "y": 0},
      "options": {
        "mode": "markdown",
        "content": "# Backend Overview\n\nHTTP запросы, latency, ошибки"
      },
      "transparent": true
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Request Rate (rps)",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 3},
      "targets": [{"refId": "A", "expr": "sum(rate(sattva_http_requests_total[5m]))"}],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Error Rate (%)",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 3},
      "targets": [{"refId": "A", "expr": "100 * sum(rate(sattva_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(sattva_http_requests_total[5m]))"}],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "p95 Latency (s)",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 3},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, rate(sattva_http_request_duration_seconds_bucket[5m]))"}],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "In-Progress Requests",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 3},
      "targets": [{"refId": "A", "expr": "sum(sattva_http_requests_in_progress)"}],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Request Rate by Path",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 7},
      "targets": [{"refId": "A", "expr": "sum by (path) (rate(sattva_http_requests_total[5m]))"}]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Error Rate by Path",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 7},
      "targets": [{"refId": "A", "expr": "sum by (path) (rate(sattva_http_requests_total{status=~\"5..\"}[5m]))"}]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Latency p95 by Path",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 15},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le, path) (rate(sattva_http_request_duration_seconds_bucket[5m])))"}]
    }
  ]
}
