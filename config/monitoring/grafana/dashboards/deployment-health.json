{
  "title": "Deployment Health",
  "uid": "deployment-health",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": {"h": 3, "w": 24, "x": 0, "y": 0},
      "options": {
        "mode": "markdown",
        "content": "# Deployment Health\n\nService status, uptime, system resources, health checks"
      },
      "transparent": true
    },
    {
      "id": 2,
      "type": "stat",
      "title": "System Uptime (s)",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 3},
      "targets": [{"refId": "A", "expr": "sattva_app_uptime_seconds"}],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 3600, "color": "green"}
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "CPU Usage (%)",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 3},
      "targets": [{"refId": "A", "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))"}],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 70, "color": "yellow"},
              {"value": 85, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Memory Usage (%)",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 3},
      "targets": [{"refId": "A", "expr": "100 * (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes))"}],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 75, "color": "yellow"},
              {"value": 90, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Disk Usage (%)",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 3},
      "targets": [{"refId": "A", "expr": "100 * (1 - (node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"}))"}],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 80, "color": "yellow"},
              {"value": 90, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "HTTP Request Rate",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 7},
      "targets": [{"refId": "A", "expr": "sum(rate(sattva_http_requests_total[5m]))"}],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "HTTP Error Rate (%)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 7},
      "targets": [{"refId": "A", "expr": "100 * sum(rate(sattva_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(sattva_http_requests_total[5m]))"}],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 1, "color": "yellow"},
              {"value": 5, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "HTTP Latency (p95)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 15},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, rate(sattva_http_request_duration_seconds_bucket[5m]))"}],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Active Connections",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 15},
      "targets": [
        {"refId": "A", "expr": "sum(sattva_http_requests_in_progress)", "legendFormat": "HTTP Requests"},
        {"refId": "B", "expr": "sattva_active_streams", "legendFormat": "Active Streams"}
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Active Streams & Listeners",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 23},
      "targets": [
        {"refId": "A", "expr": "sattva_active_streams", "legendFormat": "Active Streams"},
        {"refId": "B", "expr": "sum(sattva_stream_listeners)", "legendFormat": "Total Listeners"}
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Memory Usage Over Time",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 23},
      "targets": [
        {"refId": "A", "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes", "legendFormat": "Used"},
        {"refId": "B", "expr": "node_memory_MemAvailable_bytes", "legendFormat": "Available"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    }
  ]
}
