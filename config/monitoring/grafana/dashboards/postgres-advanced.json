{
  "title": "PostgreSQL Advanced",
  "uid": "postgres-advanced",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "30s",
  "tags": ["postgres", "database"],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Database Status",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Database Up",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 1},
      "targets": [{"refId": "A", "expr": "pg_up"}],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "textMode": "value",
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}}},
            {"type": "value", "options": {"1": {"text": "UP", "color": "green"}}}
          ]
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Total Connections",
      "gridPos": {"h": 4, "w": 5, "x": 4, "y": 1},
      "targets": [{"refId": "A", "expr": "sum(pg_stat_database_numbackends)"}],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 50, "color": "yellow"},
              {"value": 90, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Transactions/s",
      "gridPos": {"h": 4, "w": 5, "x": 9, "y": 1},
      "targets": [{"refId": "A", "expr": "sum(rate(pg_stat_database_xact_commit[5m]) + rate(pg_stat_database_xact_rollback[5m]))"}],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {"unit": "ops"}
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Cache Hit Ratio",
      "gridPos": {"h": 4, "w": 5, "x": 14, "y": 1},
      "targets": [{"refId": "A", "expr": "100 * sum(pg_stat_database_blks_hit) / (sum(pg_stat_database_blks_hit) + sum(pg_stat_database_blks_read))"}],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "steps": [
              {"value": 0, "color": "red"},
              {"value": 80, "color": "yellow"},
              {"value": 95, "color": "green"}
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Database Size",
      "gridPos": {"h": 4, "w": 5, "x": 19, "y": 1},
      "targets": [{"refId": "A", "expr": "sum(pg_database_size_bytes) / 1024 / 1024 / 1024"}],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {"unit": "GB"}
      }
    },
    {
      "id": 7,
      "type": "row",
      "title": "Transaction Metrics",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Transactions (Commit vs Rollback)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "targets": [
        {"refId": "A", "expr": "sum(rate(pg_stat_database_xact_commit[5m]))", "legendFormat": "Commits"},
        {"refId": "B", "expr": "sum(rate(pg_stat_database_xact_rollback[5m]))", "legendFormat": "Rollbacks"}
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Active vs Idle Connections",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "targets": [
        {"refId": "A", "expr": "sum(pg_stat_activity_count{state=\"active\"})", "legendFormat": "Active"},
        {"refId": "B", "expr": "sum(pg_stat_activity_count{state=\"idle\"})", "legendFormat": "Idle"}
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Performance Metrics",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 14}
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Block I/O (Read vs Hit)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 15},
      "targets": [
        {"refId": "A", "expr": "sum(rate(pg_stat_database_blks_hit[5m]))", "legendFormat": "Cache Hits"},
        {"refId": "B", "expr": "sum(rate(pg_stat_database_blks_read[5m]))", "legendFormat": "Disk Reads"}
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Tuples (Inserted/Updated/Deleted)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 15},
      "targets": [
        {"refId": "A", "expr": "sum(rate(pg_stat_database_tup_inserted[5m]))", "legendFormat": "Inserted"},
        {"refId": "B", "expr": "sum(rate(pg_stat_database_tup_updated[5m]))", "legendFormat": "Updated"},
        {"refId": "C", "expr": "sum(rate(pg_stat_database_tup_deleted[5m]))", "legendFormat": "Deleted"}
      ]
    },
    {
      "id": 13,
      "type": "row",
      "title": "Lock & Deadlock Metrics",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 23}
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Deadlocks",
      "gridPos": {"h": 4, "w": 8, "x": 0, "y": 24},
      "targets": [{"refId": "A", "expr": "sum(rate(pg_stat_database_deadlocks[5m]))"}],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 0.01, "color": "yellow"},
              {"value": 0.1, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Lock Waits",
      "gridPos": {"h": 4, "w": 8, "x": 8, "y": 24},
      "targets": [{"refId": "A", "expr": "sum(pg_locks_count{mode=\"ExclusiveLock\"})"}],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "value"
      }
    },
    {
      "id": 16,
      "type": "stat",
      "title": "Conflicts",
      "gridPos": {"h": 4, "w": 8, "x": 16, "y": 24},
      "targets": [{"refId": "A", "expr": "sum(rate(pg_stat_database_conflicts[5m]))"}],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "value"
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Deadlocks Over Time",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 28},
      "targets": [{"refId": "A", "expr": "sum(rate(pg_stat_database_deadlocks[5m]))", "legendFormat": "Deadlocks/s"}]
    },
    {
      "id": 18,
      "type": "row",
      "title": "Table Statistics (Top 10 by Activity)",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 36}
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Top 10 Tables by Sequential Scans",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 37},
      "targets": [{"refId": "A", "expr": "topk(10, rate(pg_stat_user_tables_seq_scan[5m]))", "legendFormat": "{{relname}}"}]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Top 10 Tables by Inserts/Updates/Deletes",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 37},
      "targets": [
        {"refId": "A", "expr": "topk(10, rate(pg_stat_user_tables_n_tup_ins[5m]))", "legendFormat": "{{relname}} (insert)"},
        {"refId": "B", "expr": "topk(10, rate(pg_stat_user_tables_n_tup_upd[5m]))", "legendFormat": "{{relname}} (update)"},
        {"refId": "C", "expr": "topk(10, rate(pg_stat_user_tables_n_tup_del[5m]))", "legendFormat": "{{relname}} (delete)"}
      ]
    }
  ]
}
