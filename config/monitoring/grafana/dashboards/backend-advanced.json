{
  "title": "Backend Advanced",
  "uid": "backend-advanced",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "30s",
  "tags": ["backend", "fastapi"],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "HTTP Metrics",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Request Rate (req/s)",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 1},
      "targets": [{"refId": "A", "expr": "sum(rate(sattva_http_requests_total[5m]))"}],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "textMode": "value_and_name",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 50, "color": "yellow"},
              {"value": 100, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Error Rate (%)",
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 1},
      "targets": [{"refId": "A", "expr": "100 * sum(rate(sattva_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(sattva_http_requests_total[5m]))"}],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "textMode": "value_and_name",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 1, "color": "yellow"},
              {"value": 5, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "p50 Latency",
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 1},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.50, rate(sattva_http_request_duration_seconds_bucket[5m]))"}],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "textMode": "value_and_name",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 0.1, "color": "yellow"},
              {"value": 0.5, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "p95 Latency",
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 1},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, rate(sattva_http_request_duration_seconds_bucket[5m]))"}],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "textMode": "value_and_name",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 0.2, "color": "yellow"},
              {"value": 1, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "p99 Latency",
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 1},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.99, rate(sattva_http_request_duration_seconds_bucket[5m]))"}],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "textMode": "value_and_name",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 0.5, "color": "yellow"},
              {"value": 2, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "In-Progress",
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 1},
      "targets": [{"refId": "A", "expr": "sum(sattva_http_requests_in_progress)"}],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "textMode": "value_and_name",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 20, "color": "yellow"},
              {"value": 50, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Request Rate by Status Code",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "targets": [{"refId": "A", "expr": "sum by (status) (rate(sattva_http_requests_total[5m]))", "legendFormat": "{{status}}"}]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Request Rate by Endpoint",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "targets": [{"refId": "A", "expr": "sum by (path) (rate(sattva_http_requests_total[5m]))", "legendFormat": "{{path}}"}]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Database Connections",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 13}
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Active Connections",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 14},
      "targets": [{"refId": "A", "expr": "db_connections_active{pool=\"default\"}"}],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 15, "color": "yellow"},
              {"value": 20, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Idle Connections",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 14},
      "targets": [{"refId": "A", "expr": "db_connections_idle{pool=\"default\"}"}],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "value"
      }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Pool Size",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 14},
      "targets": [{"refId": "A", "expr": "db_pool_size{pool=\"default\"}"}],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "value"
      }
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Connection Wait Time (s)",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 14},
      "targets": [{"refId": "A", "expr": "rate(db_connection_wait_time_seconds_sum[5m]) / rate(db_connection_wait_time_seconds_count[5m])"}],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 0.05, "color": "yellow"},
              {"value": 0.1, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "DB Connection Pool Usage",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 18},
      "targets": [
        {"refId": "A", "expr": "db_connections_active{pool=\"default\"}", "legendFormat": "Active"},
        {"refId": "B", "expr": "db_connections_idle{pool=\"default\"}", "legendFormat": "Idle"},
        {"refId": "C", "expr": "db_pool_size{pool=\"default\"}", "legendFormat": "Pool Size"}
      ]
    },
    {
      "id": 16,
      "type": "row",
      "title": "Application Metrics",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 26}
    },
    {
      "id": 17,
      "type": "stat",
      "title": "Uptime (hours)",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 27},
      "targets": [{"refId": "A", "expr": "process_uptime_seconds / 3600"}],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {"unit": "h"}
      }
    },
    {
      "id": 18,
      "type": "stat",
      "title": "CPU Seconds",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 27},
      "targets": [{"refId": "A", "expr": "rate(process_cpu_seconds_total[5m])"}],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "value"
      }
    },
    {
      "id": 19,
      "type": "stat",
      "title": "Memory Usage (MB)",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 27},
      "targets": [{"refId": "A", "expr": "process_resident_memory_bytes / 1024 / 1024"}],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "MB",
          "thresholds": {
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 500, "color": "yellow"},
              {"value": 1000, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "id": 20,
      "type": "stat",
      "title": "Open File Descriptors",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 27},
      "targets": [{"refId": "A", "expr": "process_open_fds"}],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "value"
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Latency Heatmap (p50, p95, p99)",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 31},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.50, rate(sattva_http_request_duration_seconds_bucket[5m]))", "legendFormat": "p50"},
        {"refId": "B", "expr": "histogram_quantile(0.95, rate(sattva_http_request_duration_seconds_bucket[5m]))", "legendFormat": "p95"},
        {"refId": "C", "expr": "histogram_quantile(0.99, rate(sattva_http_request_duration_seconds_bucket[5m]))", "legendFormat": "p99"}
      ]
    }
  ]
}
