server {
    listen 80;
    server_name sattva-streamer.top;
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    server_name sattva-streamer.top;

    ssl_certificate /etc/letsencrypt/live/sattva-streamer.top/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sattva-streamer.top/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    client_max_body_size 50M;

    # Root directory for static files
    root /opt/tg_video_streamer/current/frontend/dist;
    index index.html;

    # Health endpoint - proxy to backend
    location /health {
        proxy_pass http://127.0.0.1:8000/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # API - proxy to backend
    location /api/ {
        proxy_pass http://127.0.0.1:8000/api/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;

        # Increased timeouts for Telegram API
        proxy_connect_timeout 120s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
    }

    # Static assets
    location /assets/ {
        try_files $uri =404;
        expires 1d;
        add_header Cache-Control "public, immutable";
    }

    # Images
    location /img/ {
        try_files $uri =404;
        expires 7d;
        add_header Cache-Control "public";
    }

    # Frontend - SPA fallback
    location = /index.html {
        # Критично: index.html не должен кэшироваться, иначе браузер может держать старые ссылки на ассеты.
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
