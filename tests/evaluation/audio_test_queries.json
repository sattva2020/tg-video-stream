    "query_id": "transcode_02",
    "endpoint": "/api/v1/audio/transcode",
    "method": "POST",
    "description": "Transcode with equalizer preset",
    "payload": {
      "source_url": "https://example.com/audio/track2.mp3",
      "format": "opus",
      "codec": "libopus",
      "quality": "medium",
      "speed": 1.0,
