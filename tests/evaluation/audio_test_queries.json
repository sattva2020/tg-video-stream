    },
    "expected_behavior": "Apply bass boost equalizer with medium quality"
  },
  {
    "query_id": "transcode_03",
    "endpoint": "/api/v1/audio/transcode",
    "method": "POST",
    "description": "Transcode with custom equalizer",
    "payload": {
      "source_url": "https://example.com/audio/track3.mp3",
      "format": "mp3",
      "codec": "libmp3lame",
      "quality": "high",
      "speed": 0.8,
      "equalizer_custom": {
        "bands": [
          {"frequency": 60, "gain": 3.0},
          {"frequency": 230, "gain": 1.5},
          {"frequency": 910, "gain": -2.0}
        ]
      }
    },
    "expected_behavior": "Apply custom 3-band equalizer with 0.8x speed"
  },
  {
    "query_id": "transcode_04",
    "endpoint": "/api/v1/audio/transcode",
    "method": "POST",
    "description": "Transcode with volume adjustment",
    "payload": {
      "source_url": "https://example.com/audio/track4.mp3",
      "format": "aac",
      "codec": "aac",
      "quality": "low",
      "speed": 2.0,
      "volume": 0.5
    },
    "expected_behavior": "Apply 2x speed with 50% volume at low quality"
  },
