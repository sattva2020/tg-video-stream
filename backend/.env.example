# Backend Environment Variables Example
# Copy this file to .env and fill in your values

# ==================== Database ====================
# Database connection URL (DB_PASSWORD is from root .env)
DATABASE_URL=postgresql://postgres:${DB_PASSWORD:-sattva_db_pass_2025_9f3c0f}@db:5432/telegram_db

# ==================== Redis ====================
REDIS_URL=redis://redis:6379

# ==================== Celery / Notifications Queue ====================
CELERY_BROKER_URL=${REDIS_URL}/0
CELERY_RESULT_BACKEND=${REDIS_URL}/1
NOTIFICATIONS_QUEUE=notifications
NOTIFICATIONS_WORKER_CONCURRENCY=5
NOTIFICATIONS_PREFETCH=1

# ==================== Notification Delivery Defaults ====================
NOTIF_RETRY_ATTEMPTS=3
NOTIF_RETRY_INTERVAL_SEC=30
NOTIF_TIMEOUT_HTTP_SEC=10
NOTIF_TIMEOUT_SMTP_SEC=15
NOTIF_FAILOVER_TIMEOUT_SEC=30
NOTIF_TEST_TIMEOUT_SEC=65
NOTIF_STORM_BATCH_SIZE=10
NOTIF_STORM_WINDOW_SEC=120

# ==================== JWT Authentication ====================
JWT_SECRET=change_this_secure_jwt_secret
ALGORITHM=HS256
# Token lifetime: 15 min default (access), 7 days (refresh)
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_SECRET=${JWT_SECRET}
TOTP_ISSUER=TelegramBroadcast

# ==================== Session Encryption ====================
SESSION_ENCRYPTION_KEY=change_this_secure_session_encryption_key

# ==================== Rate Limiting ====================
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW=60
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_WINDOW_MINUTES=15

# ==================== Security ====================
# Enable Have I Been Pwned password check
HIBP_ENABLED=false

# ==================== OAuth2 (Google) ====================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ==================== Google Drive (Public Folder Import) ====================
# API key для Google Drive API v3 (используется server-side)
# Нужен только если используете источник плейлистов "Google Drive папка".
GOOGLE_DRIVE_API_KEY=your_google_drive_api_key

# ==================== URLs ====================
FRONTEND_BASE_URL=http://localhost:3000
BACKEND_BASE_URL=http://localhost:8000

# ==================== Playlist ====================
# Для systemd backend на хосте укажите путь в /opt/sattva-streamer/backend/data/playlist.txt
PLAYLIST_PATH=/app/data/playlist.txt

# ==================== Logging ====================
LOG_LEVEL=INFO

# ==================== Audio Processing ====================
# Rust-transcoder service URL (Docker Compose internal network)
RUST_TRANSCODER_URL=http://rust-transcoder:8090

# ==================== AI / LLM for Incident Analysis ====================
# Выберите один из провайдеров (или несколько для fallback)
# OpenAI - основной провайдер
OPENAI_API_KEY=sk-your_openai_api_key

# OpenRouter - альтернатива с доступом к разным моделям
# OPENROUTER_API_KEY=sk-or-your_openrouter_api_key

# DeepSeek - бюджетный вариант
# DEEPSEEK_API_KEY=sk-your_deepseek_api_key

# Google Gemini
# GEMINI_API_KEY=your_gemini_api_key

# Универсальный ключ (fallback если специфичный не указан)
# LLM_API_KEY=your_llm_api_key

# ==================== Settings Encryption ====================
# Ключ шифрования для секретных настроек в БД (Fernet, 32 байта base64)
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ENCRYPTION_KEY=your_generated_fernet_key_here
