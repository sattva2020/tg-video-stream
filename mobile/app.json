{
  "expo": {
    "name": "Sattva Streamer",
    "slug": "sattva-streamer",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "sattva-streamer",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sattva.streamer",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "This app may use your camera for profile pictures.",
        "NSMicrophoneUsageDescription": "This app does not use your microphone.",
        "NSFaceIDUsageDescription": "This app uses Face ID for secure authentication."
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "permissions": [
        "NOTIFICATIONS"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.sattva.streamer",
      "versionCode": 1,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#ffffff"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to use Face ID for secure authentication."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "sattva-streamer-mobile"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/sattva-streamer-mobile"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
