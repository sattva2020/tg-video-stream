# API Configuration
EXPO_PUBLIC_API_URL=https://api.sattva-streamer.top
EXPO_PUBLIC_WS_URL=wss://api.sattva-streamer.top

# App Configuration
EXPO_PUBLIC_APP_NAME=Sattva Streamer
EXPO_PUBLIC_APP_ENV=development

# EAS Configuration
EXPO_PROJECT_ID=sattva-streamer-mobile

# Sentry (optional)
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=production
EXPO_PUBLIC_SENTRY_RELEASE=

# Feature Flags
EXPO_PUBLIC_ENABLE_BIOMETRIC=true
EXPO_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=true
EXPO_PUBLIC_ENABLE_OFFLINE_MODE=true
