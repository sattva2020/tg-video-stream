# Telegram API credentials (get from https://my.telegram.org/apps)
API_ID=
API_HASH=
# SESSION_STRING removed - authorization is handled via GUI
CHAT_ID=3211053168
VIDEO_QUALITY=720p
LOOP=1
MUSIC_ROOT=/app/data/music

# Database credentials (используются backend/.env)
DB_PASSWORD=sattva_db_pass_2025_9f3c0f

# Streamer settings (for systemd service on host)
# Use localhost when streamer runs outside Docker
REDIS_HOST=localhost
BACKEND_URL=http://localhost:8000

# Alerting (Alertmanager -> Telegram)
ALERTMANAGER_TELEGRAM_BOT_TOKEN=
ALERTMANAGER_TELEGRAM_CHAT_ID=3211053168

# UI defaults
VITE_DEFAULT_THEME=system

# Google Drive (Public Folder Import)
# API key для Google Drive API v3 (используется server-side)
GOOGLE_DRIVE_API_KEY=your_google_drive_api_key
