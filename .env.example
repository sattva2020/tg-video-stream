# Telegram API credentials (get from https://my.telegram.org/apps)
API_ID=
API_HASH=
# SESSION_STRING removed - authorization is handled via GUI
CHAT_ID=3211053168
VIDEO_QUALITY=720p
LOOP=1
MUSIC_ROOT=/app/data/music

# Database credentials (используются backend/.env)
DB_PASSWORD=sattva_db_pass_2025_9f3c0f

# Streamer settings (for systemd service on host)
# Use localhost when streamer runs outside Docker
REDIS_HOST=localhost
BACKEND_URL=http://localhost:8000

# Alerting (Alertmanager -> Telegram)
ALERTMANAGER_TELEGRAM_BOT_TOKEN=
ALERTMANAGER_TELEGRAM_CHAT_ID=3211053168

# UI defaults
VITE_DEFAULT_THEME=system

# Google Drive (Public Folder Import)
# API key для Google Drive API v3 (используется server-side)
GOOGLE_DRIVE_API_KEY=your_google_drive_api_key

# ============================================
# AI & CHATOPS CONFIGURATION
# ============================================

# ChatOps Telegram Bot
# Токен бота для ChatOps (отдельный от alerting бота)
CHATOPS_TELEGRAM_BOT_TOKEN=
# Разрешённые пользователи (user_id или @username через запятую)
CHATOPS_ALLOWED_USERS=

# AI Provider для анализа метрик
# Варианты: openai, anthropic, openrouter, deepseek, qwen, zai, gemini
AI_PROVIDER=openai

# OpenAI (gpt-4o-mini)
OPENAI_API_KEY=

# Anthropic Claude (claude-3-haiku)
ANTHROPIC_API_KEY=

# OpenRouter - универсальный доступ к любым моделям
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# DeepSeek (deepseek-chat) - китайская модель, хороша для кода
# https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# Qwen (Alibaba) - qwen-turbo
# https://dashscope.aliyuncs.com/
QWEN_API_KEY=

# z.ai (z1-mini)
# https://z.ai/
ZAI_API_KEY=

# Google Gemini (gemini-1.5-flash)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ============================================
# ANOMALY DETECTION CONFIGURATION
# ============================================

# Интервал проверки аномалий (секунды)
ANOMALY_CHECK_INTERVAL=60
# Интервал переобучения модели (часы)
ANOMALY_TRAIN_INTERVAL_HOURS=6
# Порог чувствительности (0.01-0.5, ниже = чувствительнее)
ANOMALY_CONTAMINATION=0.05
# Включить отправку в Alertmanager
ANOMALY_ALERTMANAGER_ENABLED=true

# ============================================
# LIVE STREAMING CONFIGURATION
# ============================================

# RTMP Ingestion Server (MediaMTX)
# Порт для RTMP входящего потока (по умолчанию: 1935)
RTMP_PORT=1935
# Путь к приложению RTMP
RTMP_PATH=/live
# Имя RTMP приложения
RTMP_APPLICATION=live

# SRT Ingestion (Secure Reliable Transport)
# Порт для SRT входящего потока (по умолчанию: 6000)
SRT_PORT=6000
# Режим SRT (caller, listener, rendezvous)
SRT_MODE=caller
# Задержка SRT в миллисекундах (для восстановления потерь)
SRT_LATENCY=120

# WebRTC Signaling Server
# Порт для WebRTC signaling сервера (WebSocket)
WEBRTC_SIGNALING_PORT=8443
# STUN сервер для NAT traversal
WEBRTC_STUN_SERVER=stun:stun.l.google.com:19302
# TURN сервер для NAT traversal (опционально)
WEBRTC_TURN_SERVER=
# TURN пользователь и пароль (если TURN сервер используется)
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_PASSWORD=

# WHIP/WHEP Protocol (WebRTC-HTTP ingestion)
# Endpoint для WHIP (входящие потоки)
WHIP_ENDPOINT_URL=/whip
# Endpoint для WHEP (исходящие потоки)
WHEP_ENDPOINT_URL=/whep

# Live Stream Recording
# Путь для сохранения записей live стримов
LIVE_RECORDING_PATH=/app/data/recordings
# Формат записи (mp4, mkv, ts)
LIVE_RECORDING_FORMAT=mp4
# Максимальный размер файла записи
LIVE_RECORDING_MAX_SIZE=5G
# Автоматическая запись live стримов
LIVE_RECORDING_AUTO_ENABLED=true

# Stream Preview
# Включить предварительный просмотр перед публикацией
STREAM_PREVIEW_ENABLED=true
# Качество превью (360p, 480p, 720p, 1080p)
STREAM_PREVIEW_QUALITY=720p

# Latency Monitoring
# Включить мониторинг задержки
LATENCY_MONITOR_ENABLED=true
# Порог задержки для оповещений (миллисекунды)
LATENCY_ALERT_THRESHOLD=5000
# Целевая задержка end-to-end (миллисекунды)
LATENCY_TARGET=5000

# Guest Co-hosting
# Максимальное количество гостей одновременно
GUEST_MAX_COUNT=10
# Время жизни приглашения (секунды, 0 = бессрочно)
GUEST_INVITE_TTL=3600

# Stream Switching
# Задержка переключения потока (миллисекунды)
STREAM_SWITCH_DELAY=2000
# Включить crossfade при переключении
STREAM_SWITCH_CROSSFADE=false

# ============================================
# DOCUMENTATION SETTINGS
# ============================================

# Домен для документации
DOCS_DOMAIN=docs.sattva-streamer.top
