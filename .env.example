# Telegram API credentials (get from https://my.telegram.org/apps)
API_ID=
API_HASH=
# SESSION_STRING removed - authorization is handled via GUI
CHAT_ID=3211053168
VIDEO_QUALITY=720p
LOOP=1
MUSIC_ROOT=/app/data/music

# Database credentials (используются backend/.env)
DB_PASSWORD=sattva_db_pass_2025_9f3c0f

# Streamer settings (for systemd service on host)
# Use localhost when streamer runs outside Docker
REDIS_HOST=localhost
BACKEND_URL=http://localhost:8000

# Alerting (Alertmanager -> Telegram)
ALERTMANAGER_TELEGRAM_BOT_TOKEN=
ALERTMANAGER_TELEGRAM_CHAT_ID=3211053168

# UI defaults
VITE_DEFAULT_THEME=system

# Google Drive (Public Folder Import)
# API key для Google Drive API v3 (используется server-side)
GOOGLE_DRIVE_API_KEY=your_google_drive_api_key

# ============================================
# AI & CHATOPS CONFIGURATION
# ============================================

# ChatOps Telegram Bot
# Токен бота для ChatOps (отдельный от alerting бота)
CHATOPS_TELEGRAM_BOT_TOKEN=
# Разрешённые пользователи (user_id или @username через запятую)
CHATOPS_ALLOWED_USERS=

# AI Provider для анализа метрик
# Варианты: openai, anthropic, openrouter, deepseek, qwen, zai, gemini
AI_PROVIDER=openai

# OpenAI (gpt-4o-mini)
OPENAI_API_KEY=

# Anthropic Claude (claude-3-haiku)
ANTHROPIC_API_KEY=

# OpenRouter - универсальный доступ к любым моделям
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# DeepSeek (deepseek-chat) - китайская модель, хороша для кода
# https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# Qwen (Alibaba) - qwen-turbo
# https://dashscope.aliyuncs.com/
QWEN_API_KEY=

# z.ai (z1-mini)
# https://z.ai/
ZAI_API_KEY=

# Google Gemini (gemini-1.5-flash)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ============================================
# ANOMALY DETECTION CONFIGURATION
# ============================================

# Интервал проверки аномалий (секунды)
ANOMALY_CHECK_INTERVAL=60
# Интервал переобучения модели (часы)
ANOMALY_TRAIN_INTERVAL_HOURS=6
# Порог чувствительности (0.01-0.5, ниже = чувствительнее)
ANOMALY_CONTAMINATION=0.05
# Включить отправку в Alertmanager
ANOMALY_ALERTMANAGER_ENABLED=true

# ============================================
# DOCUMENTATION SETTINGS
# ============================================

# Домен для документации
DOCS_DOMAIN=docs.sattva-streamer.top
